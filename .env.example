# Copy to `.env.local` for local dev (never commit real keys).
# Production: set the same names in AWS Amplify → Environment variables, then redeploy.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

